  object LlamaQuery: TSQLQuery
    FieldDefs = <>
    Database = LlamaDBconnection
    Transaction = LlamaTransaction
    ReadOnly = True
    SQL.Strings = (
      'SELECT id AS id, CONCAT(name, '': '', description) AS name, server AS server, proxy_port AS proxy_port, proxy_timeout AS proxy_timeout, max_proxy_connections AS max_proxy_connections, max_package_size AS max_package_size, cli AS cli FROM config ORDER BY priority DESC, name ASC, id ASC'
    )
    Params = <>
    Macros = <>
    Left = 632
    Top = 440
  end
  object ConfigDataQuery: TSQLQuery
    FieldDefs = <>
    Database = LlamaDBconnection
    Transaction = LlamaTransaction
    SQL.Strings = (
      'SELECT'
      '  config_data.name AS name,'
      '  config_data.title AS title,'
      '  config_data.description AS description,'
      '  config_data_type.name AS type_name,'
      '  config_data.value AS value'
      'FROM config_data'
      'LEFT JOIN config_data_type ON config_data_type.id = config_data.type_id'
      'WHERE config_data.config_id = :cid'
      'ORDER BY config_data.id ASC'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'cid'
        ParamType = ptInput
      end>
    Macros = <>
    Left = 592
    Top = 440
  end
